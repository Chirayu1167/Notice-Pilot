VITE_API_BASE_URL=http://localhost:8000/api

# Show the synthetic-demo control panel (Dashboard) and demo helpers.
# Demo mode never touches non-synthetic data; the backend additionally gates
# destructive demo endpoints behind DEMO_ENABLED.
VITE_DEMO_MODE=true

# Phase 4 agent provider. "deterministic" (default) runs the full agentic
# workflow offline with template narration. Use "openai-compatible" with the
# variables below for a live LLM narrator. Never commit real keys.
LLM_PROVIDER=deterministic
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=30

# Synthetic demo endpoints (/api/demo/*). Set to 0 to disable them.
DEMO_ENABLED=1

# Backend state directory (SQLite + uploads). Defaults to backend/storage/.
# Point at a mounted volume in deployment, e.g. NOTICE_PILOT_STORAGE=/srv/data.
NOTICE_PILOT_STORAGE=
